<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.supermarche.controller.JournalAuditController" spacing="16">

    <Label text="Journal d'audit" styleClass="titre-page"/>
    <Label text="Tracabilite des actions sensibles effectuees dans l'application" styleClass="sous-titre-page"/>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label text="Du :"/>
        <DatePicker fx:id="dateDebut"/>
        <Label text="Au :"/>
        <DatePicker fx:id="dateFin"/>
        <TextField fx:id="champFiltreAction" promptText="Filtrer par action (ex: VENTE_CREEE)" styleClass="champ-saisie" prefWidth="220"/>
        <Button text="Rechercher" styleClass="bouton-principal" onAction="#rechercher"/>
    </HBox>

    <TableView fx:id="tableJournal" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colDate" text="Date/heure" prefWidth="150"/>
            <TableColumn fx:id="colUtilisateur" text="Utilisateur" prefWidth="130"/>
            <TableColumn fx:id="colAction" text="Action" prefWidth="200"/>
            <TableColumn fx:id="colEntite" text="Entite" prefWidth="120"/>
            <TableColumn fx:id="colDetails" text="Details" prefWidth="300"/>
        </columns>
    </TableView>

</VBox>
