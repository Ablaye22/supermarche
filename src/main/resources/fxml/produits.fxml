<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.supermarche.controller.ProduitsController" spacing="16">

    <Label text="Produits" styleClass="titre-page"/>

    <HBox spacing="16" VBox.vgrow="ALWAYS">

        <VBox spacing="10" prefWidth="600" VBox.vgrow="ALWAYS">
            <HBox spacing="8">
                <TextField fx:id="champRecherche" promptText="Rechercher un produit..." styleClass="champ-saisie" HBox.hgrow="ALWAYS"/>
                <Button text="Rechercher" styleClass="bouton-secondaire" onAction="#rechercher"/>
                <Button text="Nouveau produit" styleClass="bouton-principal" onAction="#nouveauProduit"/>
            </HBox>
            <TableView fx:id="tableProduits" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colCodeBarre" text="Code-barre" prefWidth="110"/>
                    <TableColumn fx:id="colDesignation" text="Designation" prefWidth="220"/>
                    <TableColumn fx:id="colPrixAchat" text="Prix achat HT" prefWidth="100"/>
                    <TableColumn fx:id="colPrixVente" text="Prix vente TTC" prefWidth="100"/>
                    <TableColumn fx:id="colActif" text="Actif" prefWidth="60"/>
                </columns>
            </TableView>
        </VBox>

        <VBox spacing="10" prefWidth="380" styleClass="carte">
            <Label fx:id="labelTitreFormulaire" text="Nouveau produit" styleClass="label-section"/>

            <Label text="Code-barre"/>
            <TextField fx:id="champCodeBarre" styleClass="champ-saisie"/>

            <Label text="Designation"/>
            <TextField fx:id="champDesignation" styleClass="champ-saisie"/>

            <Label text="Description"/>
            <TextArea fx:id="champDescription" styleClass="champ-saisie" prefRowCount="2" wrapText="true"/>

            <HBox spacing="10">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Prix achat HT (€)"/>
                    <TextField fx:id="champPrixAchat" styleClass="champ-saisie"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Prix vente TTC (€)"/>
                    <TextField fx:id="champPrixVente" styleClass="champ-saisie"/>
                </VBox>
            </HBox>

            <HBox spacing="10">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Taux TVA (%)"/>
                    <TextField fx:id="champTauxTva" styleClass="champ-saisie"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Seuil alerte stock"/>
                    <TextField fx:id="champSeuilAlerte" styleClass="champ-saisie"/>
                </VBox>
            </HBox>

            <Label text="Unite"/>
            <ComboBox fx:id="comboUnite" maxWidth="Infinity"/>

            <HBox spacing="10">
                <Button text="Enregistrer" styleClass="bouton-principal" onAction="#enregistrerProduit" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button text="Desactiver" styleClass="bouton-danger" onAction="#desactiverProduit"/>
            </HBox>
            <Button text="Nouvelle fiche" styleClass="bouton-secondaire" onAction="#nouveauProduit" maxWidth="Infinity"/>
        </VBox>
    </HBox>

</VBox>
