<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.ColumnConstraints?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.supermarche.controller.CaisseController">

    <!-- Bandeau d'ouverture / fermeture de session, visible uniquement quand pertinent -->
    <top>
        <VBox fx:id="panneauSession" spacing="12" styleClass="carte">
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Button fx:id="boutonReduireMenu" text="☰" styleClass="bouton-secondaire" onAction="#basculerMenuReduit"
                        style="-fx-font-size: 16px; -fx-padding: 6px 12px;"/>
                <Label text="Caisse :" style="-fx-font-weight: bold;"/>
                <ComboBox fx:id="comboCaisse" prefWidth="200"/>
                <Label fx:id="labelStatutSession" text="Aucune session ouverte" styleClass="badge badge-neutre"/>
                <HBox HBox.hgrow="ALWAYS"/>
                <TextField fx:id="champFondOuverture" promptText="Fond de caisse (€)" prefWidth="160" styleClass="champ-saisie"/>
                <Button text="Ouvrir la session" styleClass="bouton-succes" onAction="#ouvrirSession" fx:id="boutonOuvrirSession"/>
                <Button text="Fermer la session" styleClass="bouton-danger" onAction="#fermerSession" fx:id="boutonFermerSession"/>
            </HBox>
            <padding><Insets bottom="12"/></padding>
        </VBox>
    </top>

    <!-- Zone principale : pave numerique a gauche, panier/paiement a droite -->
    <center>
        <HBox spacing="16">
            <padding><Insets top="16"/></padding>

            <VBox spacing="12" prefWidth="1000" styleClass="carte">
                <Label text="Saisie code-barres / quantite" styleClass="label-section"/>
                <HBox spacing="8" alignment="CENTER" style="-fx-background-color: #1B2A41; -fx-background-radius: 6px; -fx-padding: 6px 6px 6px 14px;">
                    <Label fx:id="labelAfficheurPave" text="0" styleClass="total-ticket"
                        style="-fx-text-fill: white;" maxWidth="Infinity" alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS"/>
                        <Button text="⌫" onAction="#effacerDernierChiffre" maxWidth="100" prefHeight="60"/>
                </HBox>
               <HBox spacing="20">

                    <Button text="Effacer"
                            HBox.hgrow="ALWAYS"
                            maxWidth="Infinity"
                            prefHeight="150"
                            onAction="#effacerSaisie"
                            styleClass="bouton-fonction"
                            style="-fx-background-color: red;"/>

                    <Button text="Correction"
                            HBox.hgrow="ALWAYS"
                            maxWidth="Infinity"
                            prefHeight="150"
                            styleClass="bouton-fonction"
                            style="-fx-background-color: red;"/>

                    <Button text="EAN"
                            HBox.hgrow="ALWAYS"
                            maxWidth="Infinity"
                            prefHeight="150"
                            onAction="#validerCodeBarrePave"
                            styleClass="bouton-fonction"
                            style="-fx-background-color: green;"/>

                    <Button text="Quantité"
                            HBox.hgrow="ALWAYS"
                            maxWidth="Infinity"
                            prefHeight="150"
                            onAction="#appliquerQuantitePave"
                            styleClass="bouton-fonction"
                            style="-fx-background-color: aqua;"/>

                    <Button text="PLU"
                            HBox.hgrow="ALWAYS"
                            maxWidth="Infinity"
                            prefHeight="150"
                            styleClass="bouton-fonction"
                            style="-fx-background-color: yellow;"/>

                </HBox>
                <Label fx:id="labelDernierProduitAjoute" text="Dernier article : (aucun)" wrapText="true"
                       style="-fx-text-fill: #5C6B7A; -fx-font-size: 12px;"/>

                <GridPane hgap="20" vgap="20">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="33.3"/>
                        <ColumnConstraints percentWidth="33.3"/>
                        <ColumnConstraints percentWidth="33.3"/>
                    </columnConstraints>

                    <Button text="7" onAction="#saisirChiffre" styleClass="bouton-secondaire" maxWidth="Infinity" prefHeight="130" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <Button text="8" onAction="#saisirChiffre" styleClass="bouton-secondaire" maxWidth="Infinity" prefHeight="130" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                    <Button text="9" onAction="#saisirChiffre" styleClass="bouton-secondaire" maxWidth="Infinity" prefHeight="130" GridPane.rowIndex="0" GridPane.columnIndex="2"/>

                    <Button text="4" onAction="#saisirChiffre" styleClass="bouton-secondaire" maxWidth="Infinity" prefHeight="130" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <Button text="5" onAction="#saisirChiffre" styleClass="bouton-secondaire" maxWidth="Infinity" prefHeight="130" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    <Button text="6" onAction="#saisirChiffre" styleClass="bouton-secondaire" maxWidth="Infinity" prefHeight="130" GridPane.rowIndex="1" GridPane.columnIndex="2"/>

                    <Button text="1" onAction="#saisirChiffre" styleClass="bouton-secondaire" maxWidth="Infinity" prefHeight="130" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <Button text="2" onAction="#saisirChiffre" styleClass="bouton-secondaire" maxWidth="Infinity" prefHeight="130" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                    <Button text="3" onAction="#saisirChiffre" styleClass="bouton-secondaire" maxWidth="Infinity" prefHeight="130" GridPane.rowIndex="2" GridPane.columnIndex="2"/>

                    <Button text="00" onAction="#saisirChiffre" styleClass="bouton-secondaire" maxWidth="Infinity" prefHeight="130" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <Button text="0" onAction="#saisirChiffre" styleClass="bouton-secondaire" maxWidth="Infinity" prefHeight="130" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                    <Button text="." onAction="#saisirChiffre" styleClass="bouton-secondaire" maxWidth="Infinity" prefHeight="130" GridPane.rowIndex="3" GridPane.columnIndex="2"/>
                </GridPane>
            </VBox>

            <VBox spacing="10" prefWidth="600" styleClass="panneau-ticket carte">
                <Label text="Ticket en cours" styleClass="label-section"/>

                <TableView fx:id="tablePanier" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colPanierDesignation" text="Produit" prefWidth="180"/>
                        <TableColumn fx:id="colPanierQuantite" text="Qte" prefWidth="60"/>
                        <TableColumn fx:id="colPanierPrixUnitaire" text="Prix U." prefWidth="80"/>
                        <TableColumn fx:id="colPanierTotal" text="Total" prefWidth="90"/>
                    </columns>
                </TableView>

                

                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="Client (optionnel, carte fidelite) :"/>
                    <TextField fx:id="champCarteFidelite" promptText="N° carte" prefWidth="140" styleClass="champ-saisie"/>
                </HBox>

                <HBox alignment="CENTER_RIGHT">
                    <Label text="Total : "/>
                    <Label fx:id="labelTotalTicket" text="0,00 €" styleClass="total-ticket"/>
                </HBox>

                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Mode de paiement :"/>
                    <ComboBox fx:id="comboModePaiement" prefWidth="160"/>
                    <TextField fx:id="champMontantPaiement" promptText="Montant" prefWidth="100" styleClass="champ-saisie"/>
                </HBox>

                <Button text="Valider la vente" styleClass="bouton-succes" onAction="#validerVente" maxWidth="Infinity"
                        style="-fx-padding: 14px; -fx-font-size: 15px;"/>
                <Button text="Annuler le ticket" styleClass="bouton-danger" onAction="#viderPanier" maxWidth="Infinity"/>
            </VBox>
        </HBox>
    </center>

</BorderPane>