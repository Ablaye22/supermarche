<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.supermarche.controller.ClientsController" spacing="16">

      <HBox alignment="CENTER_LEFT" spacing="12">
        <Button text="&#8592; Retour au menu" styleClass="bouton-retour" onAction="#retourMenu"/>
        <Region HBox.hgrow="ALWAYS"/>
    </HBox>

    <Label text="Clients" styleClass="titre-page"/>

    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <VBox spacing="10" prefWidth="650" VBox.vgrow="ALWAYS">
            <HBox spacing="8">
                <TextField fx:id="champRecherche" promptText="Rechercher par nom..." styleClass="champ-saisie" HBox.hgrow="ALWAYS"/>
                <Button text="Rechercher" styleClass="bouton-secondaire" onAction="#rechercher"/>
            </HBox>
            <TableView fx:id="tableClients" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colNomComplet" text="Nom" prefWidth="180"/>
                    <TableColumn fx:id="colTelephone" text="Telephone" prefWidth="120"/>
                    <TableColumn fx:id="colCarteFidelite" text="Carte fidelite" prefWidth="120"/>
                    <TableColumn fx:id="colPoints" text="Points" prefWidth="80"/>
                </columns>
            </TableView>
        </VBox>

        <VBox spacing="10" prefWidth="380" styleClass="carte">
            <Label fx:id="labelTitreFormulaire" text="Nouveau client" styleClass="label-section"/>

            <Label text="Nom"/>
            <TextField fx:id="champNom" styleClass="champ-saisie"/>

            <Label text="Prenom"/>
            <TextField fx:id="champPrenom" styleClass="champ-saisie"/>

            <Label text="Telephone"/>
            <TextField fx:id="champTelephone" styleClass="champ-saisie"/>

            <Label text="Email"/>
            <TextField fx:id="champEmail" styleClass="champ-saisie"/>

            <Label text="Numero de carte fidelite"/>
            <TextField fx:id="champCarteFidelite" styleClass="champ-saisie"/>

            <Button text="Enregistrer" styleClass="bouton-principal" onAction="#enregistrerClient" maxWidth="Infinity"/>
            <Button text="Nouvelle fiche" styleClass="bouton-secondaire" onAction="#nouveauClient" maxWidth="Infinity"/>
        </VBox>
    </HBox>

</VBox>
