<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.supermarche.controller.UtilisateursController" spacing="16">

    <Label text="Utilisateurs" styleClass="titre-page"/>
    <Label text="Gestion des comptes et des roles (reserve aux administrateurs)" styleClass="sous-titre-page"/>

    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <VBox spacing="10" prefWidth="650" VBox.vgrow="ALWAYS">
        <Button text="Nouveau Utilisateur" styleClass="bouton-principal" onAction="#nouveauUtilisateur"/>
    
            <TableView fx:id="tableUtilisateurs" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="IdEmploye" prefWidth="40"/>
                     <TableColumn fx:id="champIdUtilisateur" text="IdUtilisateur" prefWidth="40"/>
                    <TableColumn fx:id="colNomComplet" text="Nom" prefWidth="180"/>
                    <TableColumn fx:id="colNomUtilisateur" text="Identifiant" prefWidth="120"/>
                    <TableColumn fx:id="colRole" text="Role" prefWidth="120"/>
                    <TableColumn fx:id="colStatut" text="Statut" prefWidth="100"/>
                </columns>
            </TableView>
            <HBox spacing="10">
                <Button text="Active" styleClass="bouton-succes" onAction="#activerUtilisateur"/>
                <Button text="Lock" styleClass="bouton-danger" onAction="#desactiverUtilisateur"/>
                <Button text="Unlock" styleClass="bouton-secondaire" onAction="#deverrouillerCompte"/>
                <Button text="Reset Password" styleClass="bouton-danger" onAction="#reinitialiserPassword" />
            </HBox>
        </VBox>

        <VBox spacing="10" prefWidth="380" styleClass="carte">
            <Label fx:id="LabelTitreFormulaire" text="Nouveau compte utilisateur" styleClass="label-section"/>

            <Label fx:id="IdLabel" text="Id"/>
            <TextField fx:id="champId" styleClass="champ-saisie" disable="true"/>


            <Label text="Nom"/>
            <TextField fx:id="champNom" styleClass="champ-saisie"/>

            <Label text="Prenom"/>
            <TextField fx:id="champPrenom" styleClass="champ-saisie"/>

            <Label text="Email"/>
            <TextField fx:id="champEmail" styleClass="champ-saisie"/>

            <Label text="Identifiant de connexion"/>
            <TextField fx:id="champNomUtilisateur" styleClass="champ-saisie"/>

            <Label text="Mot de passe initial"/>
            <PasswordField fx:id="champMotDePasse" styleClass="champ-saisie"/>
            <Label text="Min. 10 caracteres, avec majuscule, minuscule et chiffre." style="-fx-font-size: 11px; -fx-text-fill: #5C6B7A;"/>

            <Label text="Role"/>
            <ComboBox fx:id="comboRole" maxWidth="Infinity"/>

            <Button fx:id="creerModifier" text="Creer le compte" styleClass="bouton-principal" onAction="#enregistrer" maxWidth="Infinity"/>
        </VBox>
    </HBox>

</VBox>
