<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.supermarche.controller.RapportsController" spacing="16">

      <HBox alignment="CENTER_LEFT" spacing="12">
        <Button text="&#8592; Retour au menu" styleClass="bouton-retour" onAction="#retourMenu"/>
        <Region HBox.hgrow="ALWAYS"/>
    </HBox>

    <Label text="Rapports" styleClass="titre-page"/>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label text="Du :"/>
        <DatePicker fx:id="dateDebut"/>
        <Label text="Au :"/>
        <DatePicker fx:id="dateFin"/>
        <Button text="Generer" styleClass="bouton-principal" onAction="#genererRapport"/>
        <Button text="Exporter en PDF" styleClass="bouton-secondaire" onAction="#exporterPdfRapport"/>
    </HBox>

    <HBox spacing="16">
        <VBox styleClass="carte carte-indicateur" prefWidth="220">
            <Label fx:id="labelCaTtc" text="0,00 €" styleClass="valeur"/>
            <Label text="Chiffre d'affaires TTC" styleClass="libelle"/>
        </VBox>
        <VBox styleClass="carte carte-indicateur" prefWidth="220">
            <Label fx:id="labelCaHt" text="0,00 €" styleClass="valeur"/>
            <Label text="Chiffre d'affaires HT" styleClass="libelle"/>
        </VBox>
        <VBox styleClass="carte carte-indicateur" prefWidth="220">
            <Label fx:id="labelTva" text="0,00 €" styleClass="valeur"/>
            <Label text="TVA collectee" styleClass="libelle"/>
        </VBox>
        <VBox styleClass="carte carte-indicateur" prefWidth="220">
            <Label fx:id="labelNbVentes" text="0" styleClass="valeur"/>
            <Label text="Nombre de ventes" styleClass="libelle"/>
        </VBox>
    </HBox>

    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <VBox styleClass="carte" prefWidth="480" VBox.vgrow="ALWAYS">
            <Label text="Ventes par jour" styleClass="label-section"/>
            <TableView fx:id="tableVentesParJour" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colJour" text="Jour" prefWidth="120"/>
                    <TableColumn fx:id="colTotalJour" text="Total TTC" prefWidth="120"/>
                    <TableColumn fx:id="colNbVentesJour" text="Nb ventes" prefWidth="100"/>
                </columns>
            </TableView>
        </VBox>

        <VBox styleClass="carte" prefWidth="480" VBox.vgrow="ALWAYS">
            <Label text="Meilleures ventes" styleClass="label-section"/>
            <TableView fx:id="tableTopProduits" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colProduit" text="Produit" prefWidth="220"/>
                    <TableColumn fx:id="colQuantite" text="Qte" prefWidth="80"/>
                    <TableColumn fx:id="colCaProduit" text="CA" prefWidth="100"/>
                </columns>
            </TableView>
        </VBox>
    </HBox>

</VBox>
